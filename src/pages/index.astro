---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';
import Hero from '../components/home/Hero.astro';
import AboutProcess from '../components/home/AboutProcess.astro';
import Services from '../components/home/Services.astro';
import Work from '../components/home/Work.astro';
import Partners from '../components/home/Partners.astro';
import Team from '../components/home/Team.astro';
import Contact from '../components/home/Contact.astro';
const entry = await getEntry('homepage', 'en');
if (!entry) throw new Error('Missing homepage content.');
const content = entry.data;
---
<Layout>
  <div class="opening-sections">
    <Hero content={content.hero} draftLabel={content.draftLabel} />
    <Services content={content.services} />
  </div>
  <AboutProcess about={content.about} process={content.process} />
  <Work content={content.work} services={content.services.items} />
  <Partners content={content.partners} />
  <Team content={content.team} />
  <Contact content={content.contact} services={content.services.items} />
</Layout>

<style>
  .opening-sections { background: #fff; }
</style>
