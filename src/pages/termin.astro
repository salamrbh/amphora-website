---
import Layout from '../layouts/Layout.astro';
import routes from '../content/routes.json';
import { getEntry } from 'astro:content';
const content = (await getEntry('systems', 'en'))!.data;
const services = content.services.items;
---
<Layout title="Discuss a project — Amphora" description="Book a conversation with Amphora about your next digital project.">
  <section class="booking-page shell section" aria-labelledby="booking-heading">
    <div class="booking-intro"><p class="eyebrow">A conversation with Amphora</p><h1 class="section-heading" id="booking-heading">Your next step.<br /><span class="editorial">Let’s talk it through.</span></h1><p>Choose a time that works for you. Bring your idea, a question, or something you would like to make work better.</p></div>
    <label class="booking-context">Your conversation<select id="booking-service"><option value="project">Systems · A digital project</option>{services.map((service) => <option value={service.id}>Systems · {service.name}</option>)}<option value="support">Systems · Ongoing support</option></select></label>
    <div class="booking-widget"><div class="calendly-inline-widget" data-auto-load="false" data-url={routes.calendly} style="min-width:280px;height:800px"></div></div>
    <p class="booking-fallback">Can’t see the calendar? <a href={routes.calendly} target="_blank" rel="noopener noreferrer">Open Calendly directly <span aria-hidden="true">↗</span></a></p>
    <a class="text-link" href={routes.contact} id="booking-enquiry">Prefer to write? Send a project enquiry</a>
  </section>
  <script is:inline>
    window.addEventListener('message', (event) => {
      if (event.origin !== 'https://calendly.com' || event.data?.event !== 'calendly.event_scheduled') return;
      const frame = document.querySelector('.calendly-inline-widget iframe');
      if (!frame || event.source !== frame.contentWindow) return;
      window.location.assign('/danke-termin');
    });
  </script>
  <script id="calendly-script" is:inline src="https://assets.calendly.com/assets/external/widget.js" async></script>
</Layout>
<script>
  const select = document.querySelector<HTMLSelectElement>('#booking-service');
  const link = document.querySelector<HTMLAnchorElement>('#booking-enquiry');
  const widget = document.querySelector<HTMLElement>('.calendly-inline-widget');
  const calendlyWindow = window as typeof window & { Calendly?: { initInlineWidget: (options: { url: string; parentElement: HTMLElement; utm: Record<string, string> }) => void } };
  let mountedService: string | undefined;
  const mountCalendar = () => {
    if (!calendlyWindow.Calendly || !widget?.dataset.url || !select || mountedService === select.value) return;
    mountedService = select.value;
    widget.replaceChildren();
    // Keep the supplied URL intact; attach the enquiry context via the embed API.
    calendlyWindow.Calendly.initInlineWidget({ url: widget.dataset.url, parentElement: widget, utm: { utmSource: 'amphora', utmMedium: 'website', utmCampaign: 'systems', utmContent: select.value } });
  };
  const requested = new URLSearchParams(location.search).get('service');
  if (select && requested && [...select.options].some((option) => option.value === requested)) select.value = requested;
  const updateContext = () => {
    if (!select || !link) return;
    const url = new URL(location.href); url.searchParams.set('area', 'systems'); url.searchParams.set('service', select.value); history.replaceState(null, '', url);
    const enquiry = new URL(link.href); enquiry.searchParams.set('service', select.value); link.href = enquiry.pathname + enquiry.search + enquiry.hash;
    mountCalendar();
  };
  updateContext();
  select?.addEventListener('change', updateContext);
  document.querySelector('#calendly-script')?.addEventListener('load', mountCalendar, { once: true });
</script>
<style>
  .booking-page { max-width: 1040px; padding-top: 68px; }
  .booking-intro { max-width: 630px; }
  h1 { margin-top: 28px; }
  .booking-intro > p:last-child { margin-top: 26px; font-size: 16px; line-height: 1.8; color: var(--color-muted); }
  .booking-context { display: block; margin-block: 32px 24px; font-size: 12px; }
  select { display: block; max-width: 100%; margin-top: 10px; padding: 12px; border: 1px solid var(--color-line); border-radius: 6px; font-size: 14px; background: white; }
  .booking-widget { background: #0a0a0a; padding: 16px 0; border-radius: 16px; overflow: hidden; }
  .booking-fallback { margin-block: 24px; font-size: 13px; line-height: 1.8; color: var(--color-muted); }
  .booking-fallback a { text-decoration: underline; text-underline-offset: 4px; color: var(--color-ink); }
</style>
