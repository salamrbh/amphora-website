---
import type { CollectionEntry } from 'astro:content';
import Brand from './Brand.astro';
import routes from '../content/routes.json';
interface Props { site: CollectionEntry<'site'>['data']; }
const { site } = Astro.props;
---
<footer class="site-footer">
  <div class="shell">
    <div class="footer-top">
      <div><Brand label={site.homeLabel} /><p>{site.footer.tagline}</p></div>
      <div class="footer-contact"><a href={`mailto:${site.email}`}>{site.email}</a><span>{site.footer.location}</span></div>
    </div>
    <nav class="footer-navigation" aria-label="Footer navigation">{site.navigation.map((item) => <a href={item.href === routes.skills && !routes.skillsReady ? `${routes.systems}#skills` : item.href}>{item.label}{item.href === routes.skills && !routes.skillsReady ? ' · coming next' : ''}</a>)}</nav>
    <div class="footer-bottom">
      <p>© {new Date().getFullYear()} {site.footer.copyright}</p>
      <div>{site.footer.legalLinks.map((link) => <a href={link.href} lang="de">{link.label}</a>)}</div>
    </div>
  </div>
</footer>
<style>
  .site-footer { border-top: 1px solid var(--color-line); padding-block: 46px 24px; }
  .footer-top { display: flex; justify-content: space-between; align-items: center; gap: 32px; padding-bottom: 42px; }
  .footer-top p { color: var(--color-muted); font-size: 14px; margin-top: 9px; }
  .footer-contact { display: flex; flex-direction: column; gap: 10px; font-size: 14px; text-align: right; }
  .footer-contact span { color: var(--color-muted); }
  .footer-navigation { display: flex; flex-wrap: wrap; gap: 12px 28px; font-size: 12px; padding-bottom: 24px; }
  .footer-navigation a { display: inline-flex; align-items: center; min-height: 32px; }
  .footer-bottom { display: flex; justify-content: space-between; gap: 24px; border-top: 1px solid var(--color-line); padding-top: 24px; font-size: 12px; color: var(--color-muted); }
  .footer-bottom div { display: flex; gap: 24px; }
  a:hover { text-decoration: underline; text-underline-offset: 5px; }
  @media (max-width: 600px) { .footer-top { align-items: flex-start; flex-direction: column; } .footer-contact { text-align: left; } }
</style>
