---
import type { CollectionEntry } from 'astro:content';
import Brand from './Brand.astro';
import Icon from './Icon.astro';
import routes from '../content/routes.json';
interface Props { site: CollectionEntry<'site'>['data']; }
const onSkills = Astro.url.pathname.replace(/\/$/, '') === routes.skills;
const site = onSkills ? {
  ...Astro.props.site,
  navigation: Astro.props.site.navigation.map(item => ({ ...item, href: item.href === routes.about ? `${routes.skills}#about` : item.href === routes.contact ? `${routes.skills}#contact` : item.href })),
  booking: { label: 'Discuss a training project', href: `${routes.booking}?area=skills` },
} : Astro.props.site;
const navigation = site.navigation.map((item) => ({ ...item, upcoming: item.href === routes.skills && !routes.skillsReady, href: item.href === routes.skills && !routes.skillsReady ? `${routes.systems}#skills` : item.href }));
const isCurrent = (href: string) => href === routes.skills ? onSkills : href === routes.systems && [routes.systems, '/'].includes(Astro.url.pathname.replace(/\/$/, '') || '/');
---
<header class="site-header" id="top" lang={site.lang}>
  <span class="header-glow" aria-hidden="true"></span>
  <div class="header-inner">
    <Brand label={site.homeLabel} />
    <nav class="desktop-nav" aria-label={site.navigationLabel}>
      {navigation.map((item) => <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}{item.upcoming && <span class="soon">Soon</span>}</a>)}
    </nav>
    <a class="button button-dark button-metallic header-cta" href={site.booking.href}>{site.booking.label}<Icon /></a>
    <details class="mobile-nav">
      <summary>{site.menuLabel}<span class="menu-icon" aria-hidden="true"></span></summary>
      <nav aria-label={site.navigationLabel}>
        {navigation.map((item) => <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}><span>{item.label}{item.upcoming && <span class="soon">Soon</span>}</span><Icon /></a>)}
        <a class="mobile-booking" href={site.booking.href}>{site.booking.label}<Icon /></a>
      </nav>
    </details>
  </div>
</header>
<script>
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-nav');
  const closeMenu = (restoreFocus = false) => {
    if (!menu?.open) return;
    menu.open = false;
    if (restoreFocus) menu.querySelector('summary')?.focus();
  };
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => closeMenu()));
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeMenu(true); });
  document.addEventListener('click', (event) => { if (event.target instanceof Node && !menu?.contains(event.target)) closeMenu(); });
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => { if (event.matches) closeMenu(); });
</script>
<style>
  .site-header {
    position: sticky;
    top: var(--header-top);
    z-index: 50;
    isolation: isolate;
    width: calc((100% - clamp(40px, 4.6vw, 80px)) * 0.88);
    margin: var(--header-top) auto 0;
    border: 1px solid transparent;
    border-radius: 22.4px;
    background: rgb(255 255 255 / 80%);
    box-shadow: 0 2px 3px #25233d12, 0 8px 20px #25233d06, inset 0 -2px 0 #ffffff;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .header-glow {
    position: absolute;
    inset: -3px;
    z-index: -1;
    border-radius: inherit;
    pointer-events: none;
    filter: blur(7px);
    opacity: 0.4;
  }
  .header-glow::before, .site-header::after {
    content: '';
    position: absolute;
    border-radius: inherit;
    pointer-events: none;
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask-composite: exclude;
  }
  .header-glow::before {
    inset: 0;
    padding: 5px;
    background: conic-gradient(from 90deg, #e94f87, #f47a45, #f7bd2f, #27cfd0, #5965e8, #9656dc, #e94f87);
  }
  .site-header::after {
    inset: -1px;
    z-index: -1;
    padding: 1px;
    background: linear-gradient(110deg, #a5aaff99, #e8dcff99 30%, #f8dce999 68%, #f9e5db99);
  }
  .header-inner { min-height: var(--header-height); padding-inline: 32px 19.2px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 25.6px; }
  .header-inner :global(.brand) { width: 118.4px; height: 36.8px; }
  .header-inner :global(.brand img) { width: 118.4px; }
  .desktop-nav { display: flex; align-items: center; justify-content: center; gap: 27.2px; }
  .desktop-nav a { font-size: 12px; padding-block: 11.2px; white-space: nowrap; transition: color 180ms ease; }
  .desktop-nav a:hover { color: var(--color-muted); }
  .desktop-nav a[aria-current] { text-decoration: underline; text-underline-offset: 5.6px; text-decoration-color: var(--color-accent); }
  .soon { margin-left: 4.8px; font-size: 7.2px; color: var(--color-muted); }
  .header-cta { justify-self: end; min-height: 44.8px; padding: 12.8px 17.6px; border-radius: 12.8px; background-color: #18181b; font-size: 11.2px; gap: 24px; white-space: nowrap; }
  .header-cta :global(svg) { width: 13.6px; height: 13.6px; }
  .mobile-nav { display: none; }
  @media (min-width: 1024px) and (max-width: 1199px) { .desktop-nav { gap: 19.2px; } .header-inner { gap: 19.2px; padding-inline: 22.4px 16px; } }
  @media (max-width: 1023px) {
    .site-header { width: calc((100% - 32px) * 0.88); border-radius: 17.6px; }
    .header-inner { display: flex; justify-content: space-between; padding-inline: 19.2px; gap: 16px; }
    .desktop-nav, .header-cta { display: none; }
    .mobile-nav { display: block; }
    summary { cursor: pointer; display: flex; min-height: 44px; align-items: center; gap: 11.2px; font-size: 11.2px; list-style: none; }
    summary::-webkit-details-marker { display: none; }
    .menu-icon { width: 16px; height: 6.4px; border-block: 1.5px solid; }
    .mobile-nav[open] .menu-icon { height: 2px; }
    .mobile-nav nav { position: absolute; inset: calc(100% + 8px) 0 auto; max-height: calc(100dvh - var(--header-top) - var(--header-height) - 32px); overflow-y: auto; padding: 9.6px 19.2px 19.2px; font-size: 12.8px; background: var(--color-paper); border: 1px solid var(--color-line); border-radius: 17.6px; box-shadow: 0 12px 30px #24242414; }
    .mobile-nav nav a { padding: 13.6px 0; display: flex; align-items: center; justify-content: space-between; border-top: 1px solid var(--color-line); }
    .mobile-nav nav :global(svg) { width: 14.4px; }
    .mobile-booking { color: var(--color-ink); font-weight: 500; }
  }
  @media (max-width: 479px) { .site-header { width: calc((100% - 24px) * 0.88); } .header-inner { padding-inline: 14.4px; } }
</style>
