---
interface Props { id: string; content: { heading: string; emphasis: string; description?: string }; }
const { id, content } = Astro.props;
---
<div class="section-intro">
  <div><h2 class="section-heading" id={id}><slot name="heading">{content.heading}</slot><br /><span class="editorial"><slot name="emphasis">{content.emphasis}</slot></span></h2>{content.description && <p class="section-description">{content.description}</p>}</div>
</div>
<style>
  .section-intro { margin-bottom: 48px; }

  .section-description { max-width: 540px; font-size: 15px; line-height: 1.75; color: var(--color-muted); margin-top: 22px; }
  @media (max-width: 767px) { .section-intro { margin-bottom: 32px; } }
</style>
