---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import salam from '../../assets/team/salam-original.png';
import Icon from '../Icon.astro';
import FaqToggleIcon from '../FaqToggleIcon.astro';
import LocalPicture from '../LocalPicture.astro';
import routes from '../../content/routes.json';
interface Props { about: CollectionEntry<'systems'>['data']['about']; faq: CollectionEntry<'systems'>['data']['faq']; }
const { about, faq } = Astro.props;
const headingWord = about.heading.split(' ')[0];
---
<div class="faq-stack">
<section class="section shell about" id="about" aria-labelledby="about-heading">
  <div class="about-copy"><h2 class="section-heading" id="about-heading"><span class="about-heading-gradient">{headingWord}</span>{about.heading.slice(headingWord.length)}<br /><span class="editorial">{about.emphasis}</span></h2></div>
  <div class="people">
    <figure>
      <div class="portrait-frame"><div class="portrait"><Image src={salam} alt="Salam Rouabhia, co-founder of Amphora and your Systems contact" width={480} height={540} widths={[240, 360, 480]} sizes="(min-width: 768px) 340px, 85vw" format="webp" quality={82} fit="cover" loading="lazy" /></div></div>
      <figcaption><strong>{about.name}</strong><span>{about.role}</span><p>Coming soon</p></figcaption>
    </figure>
    <a class="skills-person" href={`${routes.skills}#about`}><span class="portrait-frame portrait-frame-avatar"><LocalPicture src="/images/team/marcel-192.webp" alt="" width={192} height={192} /></span><span><strong>{about.marcel.name}</strong><span>{about.marcel.role}</span></span><Icon /></a>
  </div>
</section>
<section class="section faq" id="faq" aria-labelledby="faq-heading"><div class="shell faq-panel">
  <div class="faq-intro">
    <h2 class="section-heading" id="faq-heading">{faq.description?.split(/(\bknow\b)/).map(part => part === 'know' ? <span class="faq-heading-gradient">{part}</span> : part)}</h2>
  </div>
  <div class="faq-list">{faq.items.map((item) => <details><summary><span class="faq-question">{item.question}</span><FaqToggleIcon /></summary><p>{item.answer}</p></details>)}</div>
</div></section>
</div>
<script>
  const aboutSection = document.querySelector<HTMLElement>('.faq-stack .about');
  if (aboutSection && 'ResizeObserver' in window) {
    const observer = new ResizeObserver(() => {
      aboutSection.style.setProperty('--about-height', `${aboutSection.offsetHeight}px`);
      aboutSection.classList.add('scroll-backdrop');
    });
    observer.observe(aboutSection);
  }
  const aboutHeading = document.querySelector<HTMLElement>('.about-heading-gradient');
  if (aboutHeading) {
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(([entry]) => {
        aboutHeading.classList.toggle('is-visible', entry.isIntersecting);
      }, { threshold: .25 });
      observer.observe(aboutHeading);
    } else {
      aboutHeading.classList.add('is-visible');
    }
  }
</script>
<style>
  .about { display: grid; grid-template-columns: 1.3fr 1fr; gap: 90px; align-items: center; }

  .about-heading-gradient { display: inline-block; background-image: var(--brand-gradient-interactive); -webkit-background-clip: text; background-clip: text; color: transparent; }
  @media (prefers-reduced-motion: no-preference) and (forced-colors: none) {
    .about-heading-gradient {
      background-image: linear-gradient(115deg, transparent 18%, #ffffff24 34%, #ffffff70 44%, #ffffff70 48%, #ffffff24 58%, transparent 70%), var(--brand-gradient-interactive);
      background-size: 200% 100%, 100% 100%;
      background-repeat: no-repeat;
      background-position: -100% 0, 0 0;
      animation: about-metallic-slide 7s linear infinite paused;
    }
    .about-heading-gradient.is-visible { animation-play-state: running; }
    @keyframes about-metallic-slide {
      0%, 10% { background-position: -100% 0, 0 0; }
      90%, 100% { background-position: 200% 0, 0 0; }
    }
  }
  @media (forced-colors: active) { .about-heading-gradient { background: none; color: inherit; } }
  .about a :global(svg) { width: 18px; }
  .people { width: min(100%, 340px); justify-self: center; }
  figure { margin: 0; width: 100%; max-width: 340px; }
  .portrait { background: var(--color-surface); border-radius: 14px; overflow: hidden; }
  .portrait :global(img) { width: 100%; height: auto; aspect-ratio: 8 / 9; object-fit: cover; }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .portrait :global(img) { transition: transform 500ms cubic-bezier(.22, 1, .36, 1), filter 400ms ease; }
    .portrait:hover :global(img) { transform: scale(1.035); filter: saturate(1.05) contrast(1.02); }
  }
  figcaption { padding-block: 22px; }
  figcaption strong { font-size: 22px; font-weight: 500; letter-spacing: -.03em; }
  figcaption span { font-size: 12px; display: block; color: var(--color-muted); margin-top: 8px; }
  figcaption p { font-size: 11px; line-height: 1.7; color: var(--color-muted); margin-top: 14px; }
  .skills-person { display: flex; align-items: center; gap: 14px; border-top: 1px solid var(--color-line); padding-top: 18px; min-height: 44px; }
  .skills-person :global(picture) { flex: none; }
  .skills-person :global(img) { width: 50px; height: 50px; object-fit: cover; border-radius: 50%; }
  .skills-person strong { font-size: 13px; font-weight: 500; }
  .skills-person span span { display: block; margin-top: 5px; font-size: 10px; color: var(--color-muted); }
  .skills-person > :global(svg) { width: 17px; margin-left: auto; flex: none; }
  .faq-stack { position: relative; isolation: isolate; }
  .faq { position: relative; z-index: 1; }
  /* Cover the preceding section as the bottom of the panel scrolls away. */
  .faq::after { content: ''; position: absolute; z-index: -1; inset: 50% 0 0; background: var(--color-paper); pointer-events: none; }
  @media (prefers-reduced-motion: no-preference) {
    .about.scroll-backdrop {
      position: sticky;
      top: min(calc(var(--header-top) + var(--header-height) + 16px), calc(100svh - var(--about-height) - 24px));
    }
  }
  .faq-panel {
    --color-ink: #fff;
    --color-muted: #fff;
    --color-line: #ffffff33;
    position: relative;
    isolation: isolate;
    padding: clamp(24px, 4vw, 56px);
    border-radius: 22.4px;
    color: #fff;
  }
  .faq-panel::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -5%;
    inset-inline: max(-5%, calc((100% - 100vw) / 2 + 20px));
    border-radius: inherit;
    background: #18181b;
    box-shadow: 0 -12px 32px #2828260d;
    pointer-events: none;
  }
  .faq-intro { display: grid; grid-template-columns: 1fr; gap: 32px; margin-bottom: 48px; text-align: center; }

  .faq-intro h2 { max-width: 960px; margin-inline: auto; font-size: clamp(2.75rem, 5.2vw, 5.25rem); font-weight: 700; font-style: normal; line-height: 1.16; letter-spacing: -.04em; text-wrap: balance; }
  .faq-list { max-width: 800px; margin-inline: auto; }
  .faq-heading-gradient { display: inline-block; padding: .06em .08em; margin: -.06em -.08em; background-image: var(--brand-gradient); -webkit-background-clip: text; background-clip: text; color: transparent; }
  @media (forced-colors: active) { .faq-heading-gradient { background: none; color: inherit; } }
  details { border-top: 1px solid var(--color-line); }
  details:last-child { border-bottom: 1px solid var(--color-line); }
  summary { display: grid; grid-template-columns: minmax(0, 1fr) 30px; align-items: center; gap: 24px; padding-block: 23px; list-style: none; cursor: pointer; font-size: 18px; font-weight: 700; line-height: 1.5; }
  .faq-question { justify-self: start; width: fit-content; max-width: 100%; text-align: left; }
  summary::-webkit-details-marker { display: none; }
  details[open] .faq-question {
    background-image: var(--brand-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  @media (forced-colors: active) {
    details[open] .faq-question { background: none; color: CanvasText; }
  }
  details p { font-size: 14px; font-weight: 400; color: var(--color-muted); line-height: 1.8; padding: 0 35px 25px 0; }
  @media (max-width: 1100px) { .about { gap: 40px; } }
  @media (max-width: 767px) { .about { grid-template-columns: 1fr; gap: 36px; } .people { justify-self: start; } .faq-intro { gap: 24px; margin-bottom: 32px; } }
</style>
