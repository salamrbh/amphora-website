---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import salam from '../../assets/team/salam-original.png';
import marcel from '../../assets/team/marcel-original.png';
import Icon from '../Icon.astro';
import SectionHeading from './SectionHeading.astro';
interface Props { about: CollectionEntry<'systems'>['data']['about']; faq: CollectionEntry<'systems'>['data']['faq']; }
const { about, faq } = Astro.props;
const headingWord = about.heading.split(' ')[0];
const people = [
  { name: about.name, role: about.role, imageAlt: 'Salam Rouabhia, co-founder of Amphora and your Systems contact', image: salam },
  { ...about.marcel, image: marcel },
];
---
<section class="section shell about" id="about" aria-labelledby="about-heading">
  <div class="about-copy"><p class="eyebrow"><span class="section-index">09 /</span>{about.eyebrow}</p><h2 class="section-heading" id="about-heading"><span class="about-heading-gradient">{headingWord}</span>{about.heading.slice(headingWord.length)}<br /><span class="editorial">{about.emphasis}</span></h2><p class="about-description">{about.description}</p><p class="connection">{about.connection}</p><a class="text-link" href="#contact">Talk to Salam<Icon /></a></div>
  <div class="team-grid">
    {people.map((person) => (
      <figure>
        <div class="portrait"><Image src={person.image} alt={person.imageAlt} width={480} height={540} widths={[240, 360, 480]} sizes="(min-width: 1280px) 285px, (min-width: 1024px) 25vw, (min-width: 768px) 320px, (min-width: 480px) 42vw, 85vw" format="webp" quality={82} fit="cover" loading="lazy" /></div>
        <figcaption><strong>{person.name}</strong><span>{person.role}</span><p>Coming soon</p></figcaption>
      </figure>
    ))}
  </div>
</section>
<section class="section faq" id="faq" aria-labelledby="faq-heading"><div class="shell">
  <SectionHeading number="10" id="faq-heading" content={faq} />
  <div class="faq-list">{faq.items.map((item) => <details><summary>{item.question}<Icon name="plus" /></summary><p>{item.answer}</p></details>)}</div>
</div></section>
<script>
  const aboutHeading = document.querySelector<HTMLElement>('.about-heading-gradient');
  if (aboutHeading) {
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(([entry]) => {
        aboutHeading.classList.toggle('is-visible', entry.isIntersecting);
      }, { threshold: .25 });
      observer.observe(aboutHeading);
    } else {
      aboutHeading.classList.add('is-visible');
    }
  }
</script>
<style>
  .about { display: grid; grid-template-columns: 1fr 1.35fr; gap: 64px; align-items: center; }
  .about h2 { margin-top: 34px; }
  .about-heading-gradient { display: inline-block; background-image: var(--brand-gradient-interactive); -webkit-background-clip: text; background-clip: text; color: transparent; }
  @media (prefers-reduced-motion: no-preference) and (forced-colors: none) {
    .about-heading-gradient {
      background-image: linear-gradient(115deg, transparent 18%, #ffffff24 34%, #ffffff70 44%, #ffffff70 48%, #ffffff24 58%, transparent 70%), var(--brand-gradient-interactive);
      background-size: 200% 100%, 100% 100%;
      background-repeat: no-repeat;
      background-position: -100% 0, 0 0;
      animation: about-metallic-slide 7s linear infinite paused;
    }
    .about-heading-gradient.is-visible { animation-play-state: running; }
    @keyframes about-metallic-slide {
      0%, 10% { background-position: -100% 0, 0 0; }
      90%, 100% { background-position: 200% 0, 0 0; }
    }
  }
  @media (forced-colors: active) { .about-heading-gradient { background: none; color: inherit; } }
  .about-description { max-width: 530px; font-size: 17px; line-height: 1.8; margin-top: 28px; }
  .connection { max-width: 490px; font-size: 14px; line-height: 1.75; color: var(--color-muted); margin-top: 22px; }
  .about a { margin-top: 28px; min-height: 44px; }
  .about a :global(svg) { width: 18px; }
  .team-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  figure { margin: 0; width: 100%; max-width: 340px; }
  .portrait { background: var(--color-surface); border-radius: 14px; overflow: hidden; }
  .portrait :global(img) { width: 100%; height: auto; aspect-ratio: 8 / 9; object-fit: cover; }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .portrait :global(img) { transition: transform 500ms cubic-bezier(.22, 1, .36, 1), filter 400ms ease; }
    .portrait:hover :global(img) { transform: scale(1.035); filter: saturate(1.05) contrast(1.02); }
  }
  figcaption { margin-top: 22px; }
  figcaption strong { font-size: 20px; font-weight: 500; letter-spacing: -.03em; }
  figcaption span { font-size: 11px; display: block; color: var(--color-muted); margin-top: 7px; }
  figcaption p { font-size: 12px; line-height: 1.7; color: var(--color-muted); margin-top: 17px; }
  .faq { background: #f7f7f4; }
  .faq-list { margin-left: calc((100% + 40px) / 3); }
  details { border-top: 1px solid #ddddd5; }
  details:last-child { border-bottom: 1px solid #ddddd5; }
  summary { display: flex; justify-content: space-between; align-items: center; gap: 24px; min-height: 76px; padding-block: 22px; list-style: none; cursor: pointer; font-size: 16px; letter-spacing: -.02em; }
  summary::-webkit-details-marker { display: none; }
  summary :global(svg) { flex: none; width: 20px; height: 20px; }
  details[open] summary :global(svg) { transform: rotate(45deg); }
  details p { font-size: 14px; color: var(--color-muted); line-height: 1.8; padding: 0 40px 25px 0; max-width: 650px; }
  @media (max-width: 1023px) { .about { grid-template-columns: 1fr; gap: 40px; } .team-grid { max-width: 704px; } }
  @media (max-width: 767px) { .faq-list { margin-left: 0; } }
  @media (max-width: 479px) { .team-grid { grid-template-columns: 1fr; gap: 32px; } }
</style>
