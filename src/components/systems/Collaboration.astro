---
import type { CollectionEntry } from 'astro:content';
import SectionHeading from './SectionHeading.astro';
import Icon from '../Icon.astro';
interface Props { process: CollectionEntry<'systems'>['data']['process']; support: CollectionEntry<'systems'>['data']['support']; }
const { process, support } = Astro.props;
const directionStart = process.emphasis.lastIndexOf(' ') + 1;
---
<section class="collaboration section" id="process" aria-labelledby="process-heading">
  <div class="shell collaboration-panel"><SectionHeading id="process-heading" content={process}>
      <span slot="heading" class="process-heading-first">{process.heading}</span>
      <span slot="emphasis" class="process-heading-second">{process.emphasis.slice(0, directionStart)}<span class="direction-gradient">{process.emphasis.slice(directionStart)}</span></span>
    </SectionHeading>
    <ol class="process-list">{process.items.map((step) => <li><div class="process-card"><h3>{step.name}</h3><p>{step.description}</p><p class="client-effort">{step.effort}</p></div></li>)}</ol>
  </div>
</section>
<section class="section shell support" id="support" aria-labelledby="support-heading">
  <SectionHeading id="support-heading" content={support}>
    <span slot="emphasis" class="support-gradient" data-support-gradient>{support.emphasis}</span>
  </SectionHeading>
  <div class="support-grid">{support.items.map((item) => <div><h3>{item.name}</h3><p>{item.description}</p></div>)}</div>
  <a class="text-link" href="?service=support#contact" data-enquiry-service="support">Ask about ongoing support<Icon /></a>
</section>
<script>
  const supportHeading = document.querySelector<HTMLElement>('[data-support-gradient]');
  if (supportHeading) {
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(([entry]) => {
        supportHeading.classList.toggle('is-visible', entry.isIntersecting);
      }, { threshold: .25 });
      observer.observe(supportHeading);
    } else {
      supportHeading.classList.add('is-visible');
    }
  }
</script>
<style>
  .collaboration { background: var(--color-paper); }
  .collaboration-panel {
    position: relative;
    isolation: isolate;
    padding-block: clamp(44px, 5vw, 72px);
    color: white;
    --color-muted: #bcbcb4;
    --color-line: #50504b;
  }
  .collaboration-panel::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset-block: -5%;
    inset-inline: max(-5%, calc((100% - 100vw) / 2 + 20px));
    border-radius: 22.4px;
    background: var(--color-ink);
    pointer-events: none;
  }
  .process-heading-first { display: inline-block; margin-inline-start: calc(-1 * clamp(16px, 3vw, 48px)); }
  .process-heading-second { display: inline-block; margin-inline-start: clamp(12px, 4vw, 56px); max-width: calc(100% - clamp(12px, 4vw, 56px)); }
  .direction-gradient { display: inline-block; padding: .18em .08em; margin: -.18em -.08em; background-image: var(--brand-gradient); -webkit-background-clip: text; background-clip: text; color: transparent; }
  @media (forced-colors: active) { .direction-gradient { background: none; color: inherit; } }
  .process-list { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; margin: 0; padding: 0; list-style: none; }
  .process-list li { min-width: 0; }
  .process-card {
    position: relative;
    isolation: isolate;
    min-width: 0;
    height: 100%;
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    border: 1px solid transparent;
    border-radius: 18px;
    background:
      radial-gradient(ellipse at top left, #27cfd024, transparent 60%) padding-box,
      radial-gradient(ellipse at bottom right, #e94f8720, transparent 60%) padding-box,
      linear-gradient(#17171d, #17171d) padding-box,
      linear-gradient(#28282670, #28282670) border-box,
      var(--brand-gradient) border-box;
    box-shadow: 0 16px 32px #00000026, 0 0 24px #9656dc14;
  }
  .process-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    pointer-events: none;
    background: linear-gradient(115deg, transparent 20%, #ffffff0a 36%, #ffffff38 46%, #ffffff0d 52%, transparent 66%);
    background-size: 200% 100%;
    background-position: 100% 0;
    box-shadow: inset 0 1px 0 #ffffff40, inset 0 -1px 0 #ffffff0d;
    opacity: 0;
    transition: opacity 250ms ease, background-position 650ms cubic-bezier(.22, 1, .36, 1);
  }
  @media (hover: hover) and (pointer: fine) {
    .process-list li:hover .process-card::before { opacity: 1; background-position: 40% 0; }
  }
  h3 { font-size: 22px; letter-spacing: -.035em; line-height: 1.3; }
  .process-list p { font-size: 13px; color: #bcbcb4; line-height: 1.75; margin: 18px 0 24px; }
  .process-list .client-effort { color: #e2e2da; font-size: 11px; padding-top: 18px; border-top: 1px solid #ffffff24; margin: auto 0 0; }
  .support { border-bottom: 1px solid var(--color-line); }
  .support-gradient { display: inline-block; padding: .18em .12em .24em; margin: -.18em -.12em -.24em; }
  @media (prefers-reduced-motion: no-preference) and (forced-colors: none) {
    .support-gradient {
      background-image: var(--brand-gradient);
      -webkit-background-clip: text;
      background-clip: text;
      color: var(--color-ink);
      animation: support-gradient-fade 8s ease-in-out infinite paused;
    }
    .support-gradient.is-visible { animation-play-state: running; }
    @keyframes support-gradient-fade {
      0%, 62.5%, 100% { color: var(--color-ink); }
      25%, 37.5% { color: transparent; }
    }
  }
  .support-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 38px; text-align: center; }
  .support-grid > div { position: relative; border-top: 1px solid var(--color-line); padding-top: 25px; }
  .support-grid > div::before { content: ''; position: absolute; top: -1px; inset-inline: 0; height: 1px; background: var(--brand-gradient-interactive); opacity: 0; pointer-events: none; transition: opacity 180ms ease; }
  .support-grid > div:hover::before { opacity: 1; }
  .support-grid h3 { width: fit-content; max-width: 100%; margin-inline: auto; background-image: var(--brand-gradient-interactive); -webkit-background-clip: text; background-clip: text; transition: color 180ms ease; }
  .support-grid > div:hover h3 { color: transparent; }
  @media (forced-colors: active) { .support-grid > div:hover h3 { color: CanvasText; } }
  .support-grid p { margin: 14px auto 0; font-size: 14px; line-height: 1.75; color: var(--color-muted); max-width: 335px; }
  .support > a { display: flex; width: fit-content; max-width: 100%; margin: 36px auto 0; min-height: 44px; justify-content: center; text-align: center; }
  .support > a :global(svg) { width: 18px; }
  @media (forced-colors: active) { .process-card { border-color: CanvasText; } }
  @media (max-width: 1100px) { .process-list { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 767px) { .process-heading-first { margin-inline-start: -4px; } .support-grid { grid-template-columns: 1fr; gap: 24px; } .support-grid p { max-width: 480px; } }
  @media (max-width: 600px) { .process-list { grid-template-columns: 1fr; gap: 20px; }  }
</style>
