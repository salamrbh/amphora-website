---
import type { CollectionEntry } from 'astro:content';
import SectionHeading from './SectionHeading.astro';
interface Props { trust: CollectionEntry<'systems'>['data']['trust']; needs: CollectionEntry<'systems'>['data']['needs']; }
const { trust, needs } = Astro.props;
---
<div class="needs-stack">
<section class="trust shell" aria-labelledby="trust-heading">
  <div class="trust-top"><h2 class="eyebrow" id="trust-heading">{trust.eyebrow}</h2><p class="draft-note">{trust.note}</p></div>
  <div class="partner-carousel">
    <div class="partner-viewport">
      <div class="partner-track" id="systems-partner-track" style={`--partner-duration: ${trust.logos.length * 6}s`}>
        <ul class="partner-group" role="list">{trust.logos.map((logo) => <li><img {...logo} loading="eager" decoding="async" /></li>)}</ul>
        <ul class="partner-group partner-copy" aria-hidden="true">{trust.logos.map(({ alt: _alt, ...logo }) => <li><img {...logo} alt="" loading="eager" decoding="async" /></li>)}</ul>
      </div>
    </div>
  </div>
</section>
<section class="section needs-section" id="needs" aria-labelledby="needs-heading">
  <div class="shell needs-panel">
  <SectionHeading id="needs-heading" content={needs}>
    <span slot="heading" class="fading-gradient">{needs.heading}</span>
    <span slot="emphasis" class="fading-gradient fading-gradient-second">{needs.emphasis}</span>
  </SectionHeading>
  <div class="needs-grid">
    {needs.items.map((need) => <article class="need"><h3>{need.heading}</h3><p>{need.description}</p></article>)}
  </div>
  </div>
</section>
</div>
<script>
  const heading = document.querySelector<HTMLElement>('#needs-heading');
  if (heading) {
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(([entry]) => {
        heading.classList.toggle('is-visible', entry.isIntersecting);
      }, { threshold: .25 });
      observer.observe(heading);
    } else {
      heading.classList.add('is-visible');
    }
  }
</script>
<style>
  .needs-stack { position: relative; isolation: isolate; }
  .needs-section { position: relative; z-index: 1; }
  /* Keep the pinned logos covered as the bottom of the panel leaves the viewport. */
  .needs-section::after { content: ''; position: absolute; z-index: -1; inset: 50% 0 0; background: var(--color-paper); pointer-events: none; }
  .needs-panel {
    --color-ink: #fff;
    --color-muted: #fff;
    --color-accent: #fff;
    --color-line: #ffffff33;
    --brand-gradient-interactive: var(--brand-gradient);
    position: relative;
    isolation: isolate;
    padding-block: clamp(44px, 5vw, 72px);
    color: #fff;
  }
  .needs-panel::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset-block: -5%;
    inset-inline: max(-5%, calc((100% - 100vw) / 2 + 20px));
    border: 1px solid var(--color-line);
    border-radius: 22.4px;
    background: #18181b;
    box-shadow: 0 -12px 32px #2828260d;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    /* Hold the preceding content while the rounded panel scrolls over it. */
    .trust { position: sticky; top: calc(var(--header-top) + var(--header-height) + 16px); }
  }
  .trust { padding-block: 38px 44px; border-bottom: 1px solid var(--color-line); }
  .trust-top { display: flex; justify-content: space-between; gap: 18px; flex-wrap: wrap; }
  .partner-carousel { min-width: 0; width: 100%; margin: 30px auto 0; }
  .partner-viewport { overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); }
  .partner-track { display: flex; width: max-content; animation: partner-scroll var(--partner-duration) linear infinite; }
  .partner-group { display: flex; flex: none; align-items: center; gap: 40px; padding: 0 40px 0 0; margin: 0; list-style: none; }
  .partner-group li { display: flex; align-items: center; justify-content: center; flex: 0 0 140px; width: 140px; height: 64px; }
  .partner-group img { width: auto; max-width: 120px; height: auto; max-height: 54px; object-fit: contain; filter: brightness(0) invert(.25); }
  @keyframes partner-scroll { to { transform: translateX(-50%); } }
  .fading-gradient { display: inline-block; padding: .18em .12em .24em; margin: -.18em -.12em -.24em; }
  @media (prefers-reduced-motion: no-preference) and (forced-colors: none) {
    .fading-gradient {
      background-image: var(--brand-gradient);
      -webkit-background-clip: text;
      background-clip: text;
      color: var(--color-ink);
      /* Each line: 2s fade in, 1s hold, 2s fade out; pauses: 0.5s then 3s. */
      animation: heading-gradient-first 13.5s ease-in-out infinite paused;
    }
    .fading-gradient-second { animation-name: heading-gradient-second; }
    :global(#needs-heading.is-visible) .fading-gradient { animation-play-state: running; }
    @keyframes heading-gradient-first {
      0%, 37.037037%, 100% { color: var(--color-ink); }
      14.814815%, 22.222222% { color: transparent; }
    }
    @keyframes heading-gradient-second {
      0%, 40.740741%, 77.777778%, 100% { color: var(--color-ink); }
      55.555556%, 62.962963% { color: transparent; }
    }
  }
  .needs-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 28px; }
  .need { position: relative; display: flex; flex-direction: column; border-top: 1px solid var(--color-line); padding-top: 22px; }
  .need::before { content: ''; position: absolute; top: -1px; inset-inline: 0; height: 1px; background: var(--brand-gradient-interactive); opacity: 0; pointer-events: none; transition: opacity 180ms ease; }
  .need:hover::before { opacity: 1; }
  h3 { font-size: 23px; letter-spacing: -.035em; line-height: 1.25; max-width: 230px; background-image: var(--brand-gradient-interactive); -webkit-background-clip: text; background-clip: text; transition: color 180ms ease; }
  .need:hover h3 { color: transparent; }
  .need > p { font-size: 13px; color: var(--color-muted); line-height: 1.75; margin-top: 18px; }
  @media (forced-colors: active) { .need:hover h3 { color: CanvasText; } }
  @media (max-width: 1023px) { .needs-panel { padding-inline: 20px; } .needs-grid { grid-template-columns: repeat(2, 1fr); gap: 30px; } }
  @media (max-width: 767px) { .needs-panel::before { inset-block: 0; } .partner-group { gap: 28px; padding-right: 28px; } .partner-group li { flex-basis: 120px; width: 120px; } .partner-group img { max-width: 102px; max-height: 48px; } }
  @media (max-width: 540px) { .needs-grid { grid-template-columns: 1fr; } h3 { max-width: none; }  }
  @media (prefers-reduced-motion: reduce) {
    .partner-viewport { overflow: visible; mask-image: none; }
    .partner-track { display: block; width: 100%; animation: none; }
    .partner-group { display: flex; flex-wrap: wrap; justify-content: center; gap: 24px; padding: 0; }
    .partner-group li { width: auto; }
    .partner-copy { display: none; }
  }
</style>
