---
import type { CollectionEntry } from 'astro:content';
import LocalPicture from '../LocalPicture.astro';
import SectionHeading from './SectionHeading.astro';
interface Props { content: CollectionEntry<'systems'>['data']['sample']; }
const { content } = Astro.props;
---
<section class="sample-section section" id="sample" aria-labelledby="sample-heading">
  <div class="shell">
    <SectionHeading number="04" id="sample-heading" content={content} />
    <div class="sample-grid">
      <figure><div class="sample-screen"><div class="browser-top" aria-hidden="true"><i></i><i></i><i></i><span>Cord’s Café</span></div><LocalPicture {...content.image} /></div><figcaption><span>{content.project}</span><span>Design in focus</span></figcaption></figure>
      <div class="sample-reading">{content.items.map((item, index) => <div><span class="reading-number">0{index + 1}</span><div><h3>{item.label}</h3><p>{item.text}</p></div></div>)}<p class="draft-note">{content.note}</p></div>
    </div>
  </div>
</section>
<style>
  .sample-section {
    --section-fade: clamp(64px, 8vw, 120px);
    background: linear-gradient(to bottom, var(--color-paper), #f6f3ed var(--section-fade), #f6f3ed calc(100% - var(--section-fade)), var(--color-paper));
  }
  .sample-grid { display: grid; grid-template-columns: 1.45fr 1fr; gap: 56px; align-items: center; }
  figure { margin: 0; min-width: 0; }
  .sample-screen { padding: 34px; background: #e8dfcf; border-radius: 14px; }
  .sample-screen :global(img) { width: 100%; height: auto; box-shadow: 0 12px 28px #47372012; }
  .browser-top { display: flex; gap: 4px; align-items: center; height: 27px; padding-inline: 11px; background: #fff; border-radius: 5px 5px 0 0; }
  .browser-top i { width: 4px; height: 4px; border-radius: 50%; background: #d2cec6; }
  .browser-top span { flex: 1; text-align: center; font-size: 8px; color: var(--color-muted); margin-right: 20px; }
  figcaption { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px; font-size: 11px; margin-top: 18px; }
  figcaption span:last-child { color: var(--color-muted); }
  .sample-reading > div { display: flex; gap: 20px; padding: 21px 0; border-top: 1px solid #ded8ce; }
  .reading-number { color: #766c5c; font-size: 10px; padding-top: 5px; }
  h3 { font-size: 16px; letter-spacing: -.02em; }
  .sample-reading p:not(.draft-note) { font-size: 13px; color: var(--color-muted); line-height: 1.75; margin-top: 9px; }
  .draft-note { padding-top: 8px; }
  @media (max-width: 1023px) { .sample-grid { gap: 32px; grid-template-columns: 1fr 1fr; } .sample-screen { padding: 22px; } }
  @media (max-width: 767px) { .sample-grid { grid-template-columns: 1fr; } .sample-screen { padding: 26px 20px; } }
</style>
