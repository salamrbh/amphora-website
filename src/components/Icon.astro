---
interface Props { name?: 'arrow' | 'plus' | 'web' | 'workflow' | 'crm' | 'mobile'; class?: string; }
const { name = 'arrow', class: className } = Astro.props;
---
<svg class={className} width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'arrow' && <path d="M5 19 19 5M5 5h14v14" />}
  {name === 'plus' && <path d="M5 12h14M12 5v14" />}
  {name === 'web' && <><rect x="2.5" y="4" width="19" height="16" rx="3" /><path d="M2.5 9h19M6 6.5h.01M9 6.5h.01m-1 6-2 2 2 2m8-4 2 2-2 2m-3-5-2 6" /></>}
  {name === 'workflow' && <><rect x="3" y="3" width="6" height="6" rx="1.5" /><rect x="15" y="15" width="6" height="6" rx="1.5" /><path d="M9 6h7a2 2 0 0 1 2 2v3m-3-3 3 3 3-3M15 18H8a2 2 0 0 1-2-2v-3m-3 3 3-3 3 3" /></>}
  {name === 'crm' && <><rect x="3" y="3" width="18" height="18" rx="3" /><path d="M3 9h18M9 9v12m4-5v2m4-5v5" /></>}
  {name === 'mobile' && <><rect x="6" y="2" width="12" height="20" rx="3" /><path d="M10 5h4m-3 14h2" /></>}
</svg>
