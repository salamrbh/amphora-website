---
interface Props { src: string; alt: string; width: number; height: number; eager?: boolean; responsive?: boolean; sizes?: string; }
const { src, alt, width, height, eager = false, responsive = false, sizes = '100vw' } = Astro.props;
const avif = src.replace(/\.webp$/, '.avif');
const small = src.replace('-1280.', '-640.');
---
<picture>
  <source type="image/avif" srcset={responsive ? `${small.replace('.webp', '.avif')} 640w, ${avif} 1280w` : avif} sizes={sizes} />
  <img src={src} srcset={responsive ? `${small} 640w, ${src} 1280w` : undefined} sizes={responsive ? sizes : undefined} width={width} height={height} alt={alt} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" />
</picture>
