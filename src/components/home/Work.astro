---
import type { CollectionEntry } from 'astro:content';
import Icon from '../Icon.astro';
import LocalPicture from '../LocalPicture.astro';
interface Props {
  content: CollectionEntry<'homepage'>['data']['work'];
  services: CollectionEntry<'homepage'>['data']['services']['items'];
}
const { content, services } = Astro.props;
const names = new Map(services.map((service) => [service.id, service.name]));
for (const project of content.items) {
  for (const tag of project.services) if (!names.has(tag)) throw new Error(`Unknown service tag ${tag} on ${project.id}`);
}
---
<section class="work-section section" id="work" aria-labelledby="work-heading">
  <div class="shell">
    <div class="work-heading reveal-on-scroll">
      <div><p class="eyebrow"><span class="section-index">03 /</span>{content.eyebrow}</p><h2 class="section-heading" id="work-heading">{content.heading}<br /><span class="editorial">{content.emphasis}</span></h2></div>
      <p class="work-intro">{content.description}</p>
    </div>
    <div class="work-grid">
      {content.items.map((project, index) => (
        <article class="project reveal-on-scroll" style={`--reveal-delay: ${index * 70}ms`}>
          <div class:list={['project-preview', `preview-${project.id}`]} data-wobble>
            <div class="browser-bar" aria-hidden="true"><span></span><span></span><span></span><span class="browser-name">{project.name}</span></div>
            <div class="project-screen"><LocalPicture {...project.image} /></div>
          </div>
          <div class="project-meta"><span class="project-index">0{index + 1}</span><div><h3>{project.name}</h3><p>{project.category}</p></div></div>
          <div class="project-tags">{project.services.map((tag) => <span class="tag">{names.get(tag)}</span>)}</div>
          <details class="project-details">
            <summary><span class="when-closed">{content.expandLabel}</span><span class="when-open">{content.collapseLabel}</span><Icon name="plus" /></summary>
            <div class="project-story"><p>{project.description}</p><p class="draft-note">{content.placeholder}</p></div>
          </details>
        </article>
      ))}
    </div>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-wobble]').forEach((card) => {
    card.addEventListener('pointermove', (event) => {
      const bounds = card.getBoundingClientRect();
      const x = (event.clientX - bounds.left) / bounds.width - .5;
      const y = (event.clientY - bounds.top) / bounds.height - .5;
      card.style.setProperty('--rotate-x', `${y * -3.5}deg`);
      card.style.setProperty('--rotate-y', `${x * 4.5}deg`);
      card.style.setProperty('--shift-x', `${x * -7}px`);
      card.style.setProperty('--shift-y', `${y * -7}px`);
    });
    card.addEventListener('pointerleave', () => {
      card.style.removeProperty('--rotate-x');
      card.style.removeProperty('--rotate-y');
      card.style.removeProperty('--shift-x');
      card.style.removeProperty('--shift-y');
    });
  });
</script>
<style>
  .work-section { background: var(--color-surface); }
  .work-heading { display: flex; justify-content: space-between; align-items: flex-end; gap: 40px; margin-bottom: 46px; }
  .work-heading .eyebrow { margin-bottom: 28px; }
  .work-intro { max-width: 240px; color: var(--color-muted); font-size: 14px; line-height: 1.7; padding-bottom: 6px; }
  .work-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 52px 28px; align-items: start; }
  .project { min-width: 0; }
  .project-preview { --rotate-x: 0deg; --rotate-y: 0deg; --shift-x: 0px; --shift-y: 0px; aspect-ratio: 1.58; border-radius: 16px; padding: 32px 28px 0; overflow: hidden; background: #e9e4d9; transform: perspective(900px) rotateX(var(--rotate-x)) rotateY(var(--rotate-y)); transform-style: preserve-3d; transition: transform 180ms ease, filter 280ms ease; will-change: transform; }
  .preview-evltn { background: #dddeda; }
  .preview-grechows { background: #e0e7dc; }
  .preview-nordostsee { background: #dee4ed; }
  .browser-bar { height: 25px; background: white; border-bottom: 1px solid #eee; border-radius: 7px 7px 0 0; display: flex; align-items: center; padding: 0 10px; gap: 4px; position: relative; }
  .browser-bar > span:not(.browser-name) { width: 4px; height: 4px; background: #d3d3cd; border-radius: 50%; }
  .browser-name { position: absolute; left: 50%; transform: translateX(-50%); color: var(--color-muted); font-size: 7px; }
  .project-screen { height: calc(100% - 25px); overflow: hidden; background: white; border-radius: 0 0 3px 3px; }
  .project-screen :global(img) { width: 100%; height: auto; min-height: 100%; object-fit: cover; object-position: top; transform: translate(var(--shift-x), var(--shift-y)) scale(1.025); transition: transform 180ms ease; }
  .preview-grechows .project-screen { height: auto; }
  .project-meta { display: flex; gap: 16px; margin-top: 24px; }
  .project-index { font-size: 10px; color: var(--color-muted); padding-top: 6px; }
  h3 { font-size: 23px; letter-spacing: -.04em; line-height: 1.2; }
  .project-meta p { font-size: 12px; margin-top: 7px; color: var(--color-muted); }
  .project-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 17px; }
  .project-tags .tag { border-color: #d5d5cf; font-size: 9px; }
  .project-details { margin-top: 18px; border-top: 1px solid #d8d8d1; }
  summary { display: flex; justify-content: space-between; align-items: center; padding: 16px 0 4px; min-height: 46px; list-style: none; cursor: pointer; font-size: 12px; }
  summary::-webkit-details-marker { display: none; }
  summary :global(svg) { width: 18px; height: 18px; }
  .when-open, details[open] .when-closed { display: none; }
  details[open] .when-open { display: inline; }
  details[open] summary :global(svg) { transform: rotate(45deg); }
  .project-story { padding-block: 16px 8px; }
  .project-story > p:first-child { font-size: 14px; line-height: 1.7; }
  .project-story .draft-note { margin-top: 12px; }
  summary:hover { text-decoration: underline; text-underline-offset: 4px; }
  @media (hover: hover) and (pointer: fine) {
    .project-preview { filter: blur(1.15px) saturate(.9); }
    .project-preview:hover { filter: blur(0) saturate(1); }
  }
  @media (max-width: 767px) { .work-heading { display: block; margin-bottom: 32px; } .work-intro { margin-top: 22px; max-width: 310px; } .work-grid { grid-template-columns: 1fr; gap: 40px; } .project-preview { padding: 24px 22px 0; } h3 { font-size: 22px; } }
</style>
