---
import type { CollectionEntry } from 'astro:content';
interface Props {
  about: CollectionEntry<'homepage'>['data']['about'];
  process: CollectionEntry<'homepage'>['data']['process'];
}
const { about, process } = Astro.props;
---
<section class="about-section" id="about" aria-labelledby="about-heading">
  <div class="shell about-grid reveal-on-scroll">
    <p class="eyebrow"><span class="section-index">02 /</span>{about.eyebrow}</p>
    <div class="about-copy">
      <h2 class="section-heading" id="about-heading">{about.heading}<br /><span class="editorial">{about.emphasis}</span></h2>
      <p>{about.description}</p>
    </div>
    <div class="review-proof" aria-label={about.reviewAriaLabel} style="width:176px;height:176px;min-width:176px;min-height:176px;max-width:176px;max-height:176px;aspect-ratio:1 / 1">
      <span class="review-content" aria-hidden="true">
        <strong>{about.reviewCount}</strong>
        <svg class="google-mark" width="26" height="26" viewBox="0 0 18 18" role="presentation" style="width:26px;height:26px">
          <path fill="#4285f4" d="M17.64 9.205c0-.638-.057-1.252-.164-1.841H9v3.481h4.844a4.14 4.14 0 0 1-1.797 2.716v2.258h2.909c1.703-1.568 2.684-3.878 2.684-6.614Z" />
          <path fill="#34a853" d="M9 18c2.43 0 4.468-.806 5.957-2.181l-2.91-2.258c-.805.54-1.835.859-3.047.859-2.344 0-4.328-1.585-5.037-3.714H.956v2.333A9 9 0 0 0 9 18Z" />
          <path fill="#fbbc05" d="M3.963 10.706A5.42 5.42 0 0 1 3.68 9c0-.592.102-1.168.283-1.706V4.961H.956A9 9 0 0 0 0 9c0 1.452.347 2.827.956 4.039l3.007-2.333Z" />
          <path fill="#ea4335" d="M9 3.58c1.321 0 2.507.454 3.442 1.345l2.58-2.581C13.463.891 11.43 0 9 0A9 9 0 0 0 .956 4.961l3.007 2.333C4.672 5.165 6.656 3.58 9 3.58Z" />
        </svg>
        <span class="stars">★★★★★</span>
      </span>
    </div>
  </div>

  <div class="shell process reveal-on-scroll" id="process" aria-labelledby="process-heading">
    <div class="process-heading">
      <p class="eyebrow">{process.eyebrow}</p>
      <h3 id="process-heading">{process.heading}</h3>
      <p>{process.description}</p>
    </div>
    <ol class="process-list">
      {process.items.map((step) => (
        <li>
          <span class="step-number">{step.number}</span>
          <div><h4>{step.name}</h4><p>{step.description}</p></div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .about-section { padding-block: 112px; background: var(--color-ink); color: var(--color-paper); }
  .about-grid { display: grid; grid-template-columns: .85fr 1.75fr .65fr; gap: 44px; align-items: start; }
  .about-grid > .eyebrow { padding-top: 10px; color: #c8c8c2; }
  .about-grid .section-index { color: #8c8c86; }
  .about-copy h2 { font-size: clamp(2.8rem, 5vw, 5rem); }
  .about-copy > p { margin-top: 30px; max-width: 650px; font-size: clamp(1.05rem, 1.55vw, 1.35rem); line-height: 1.65; color: #d3d3cd; }
  .review-proof { justify-self: end; box-sizing: border-box; inline-size: 176px; block-size: 176px; min-inline-size: 176px; min-block-size: 176px; max-inline-size: 176px; max-block-size: 176px; aspect-ratio: 1 / 1; contain: strict; overflow: hidden; border-radius: 50%; display: grid; place-items: center; text-align: center; background: var(--brand-gradient-interactive); color: white; box-shadow: 0 16px 40px #00000030; }
  .review-content { display: flex; flex-direction: column; align-items: center; justify-content: center; }
  .google-mark { display: block; width: 26px; height: 26px; flex: 0 0 26px; margin-top: 14px; }
  .review-proof .stars { margin-top: 14px; color: #ffd129; font-size: 15px; line-height: 1; letter-spacing: .08em; font-weight: 700; text-shadow: 0 1px 4px #00000030; }
  .review-proof strong { font-size: 30px; line-height: 1; font-weight: 700; }
  .process { margin-top: 90px; padding-top: 52px; border-top: 1px solid #4a4a45; display: grid; grid-template-columns: .85fr 2.4fr; gap: 44px; }
  .process-heading .eyebrow { color: #aaa9a3; }
  .process-heading h3 { margin-top: 22px; font-size: 25px; letter-spacing: -.04em; }
  .process-heading > p:last-child { color: #aaa9a3; font-size: 12px; line-height: 1.7; margin-top: 13px; max-width: 230px; }
  .process-list { display: grid; grid-template-columns: repeat(4, 1fr); list-style: none; padding: 0; margin: 0; }
  .process-list li { min-width: 0; padding: 0 22px; border-left: 1px solid #4a4a45; }
  .step-number { display: block; color: var(--color-logo-cyan); font-size: 10px; margin-bottom: 48px; }
  h4 { font-size: 16px; font-weight: 500; line-height: 1.35; }
  .process-list p { color: #aaa9a3; font-size: 11px; line-height: 1.65; margin-top: 12px; }
  @media (max-width: 1023px) {
    .about-grid { grid-template-columns: .7fr 2fr; }
    .review-proof { grid-column: 2; justify-self: start; }
    .process { grid-template-columns: 1fr; }
  }
  @media (max-width: 767px) {
    .about-section { padding-block: 72px; }
    .about-grid { grid-template-columns: 1fr; gap: 30px; }
    .about-grid > .eyebrow, .review-proof { grid-column: auto; }
    .about-copy > p { font-size: 16px; margin-top: 24px; }
    .process { margin-top: 60px; padding-top: 38px; gap: 34px; }
    .process-list { grid-template-columns: 1fr 1fr; gap: 34px 0; }
    .step-number { margin-bottom: 24px; }
  }
  @media (max-width: 470px) {
    .process-list { grid-template-columns: 1fr; }
    .process-list li { display: grid; grid-template-columns: 40px 1fr; }
    .step-number { margin: 3px 0 0; }
  }
</style>
