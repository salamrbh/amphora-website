---
import type { CollectionEntry } from 'astro:content';
import Icon from '../Icon.astro';
import LocalPicture from '../LocalPicture.astro';
interface Props { content: CollectionEntry<'homepage'>['data']['hero']; draftLabel: string; }
const { content, draftLabel } = Astro.props;
---
<section class="hero shell" aria-labelledby="hero-heading">
  <div class="hero-topline"><p class="eyebrow"><span class="section-index">01 /</span>{content.eyebrow}</p><p class="draft-note">{draftLabel}</p></div>
  <div class="hero-grid">
    <div class="hero-copy">
      <h1 id="hero-heading">{content.heading}<br /><span class="editorial">{content.emphasis}</span></h1>
      <p class="hero-subline">{content.subline}</p>
      <div class="hero-actions"><a class="button button-dark button-metallic" href={content.primary.href}>{content.primary.label}<Icon /></a><a class="text-link" href={content.secondary.href}>{content.secondary.label}</a></div>
      <p class="hero-note"><span aria-hidden="true">↳</span>{content.note}</p>
    </div>
    <figure class="hero-figure">
      <div class="hero-image"><LocalPicture {...content.image} eager responsive sizes="(min-width: 1024px) 42vw, (min-width: 768px) 44vw, calc(100vw - 40px)" /></div>
      <figcaption><span>{content.imageCaption}</span><Icon /></figcaption>
      <p>{content.imageNote}</p>
    </figure>
  </div>
</section>
<style>
  .hero { padding-top: 38px; }
  .hero-topline { display: flex; align-items: center; justify-content: space-between; gap: 20px; }
  .hero-grid { display: grid; grid-template-columns: 1.18fr 1fr; gap: 50px; align-items: center; padding-block: 66px 72px; }
  h1 { font-size: clamp(3.8rem, 6.7vw, 6.5rem); line-height: 1.02; letter-spacing: -0.065em; }
  h1 .editorial { display: inline-block; position: relative; z-index: 0; white-space: nowrap; }
  h1 .editorial::after { content: ''; position: absolute; inset: 74% -3% 3%; background: var(--color-accent-soft); z-index: -1; border-radius: 3px; }
  .hero-subline { max-width: 400px; font-size: 17px; line-height: 1.65; margin-top: 30px; color: var(--color-muted); }
  .hero-actions { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; margin-top: 32px; }
  .hero-actions .text-link { font-size: 12px; }
  .hero-note { margin-top: 28px; font-size: 11px; color: var(--color-muted); display: flex; align-items: center; gap: 10px; }
  .hero-note span { font-size: 19px; }
  .hero-figure { margin: 5px 0 0; }
  .hero-image { overflow: hidden; border-radius: 18px; background: var(--color-surface); }
  .hero-image :global(img) { width: 100%; height: auto; aspect-ratio: 1.21; object-fit: cover; object-position: 57% center; }
  figcaption { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-top: 18px; font-size: 13px; font-weight: 500; }
  figcaption :global(svg) { width: 17px; height: 17px; }
  .hero-figure > p { color: var(--color-muted); font-size: 11px; margin-top: 6px; }
  @media (min-width: 1600px) { .hero-grid { padding-block: 80px 90px; } }
  @media (max-width: 1100px) { .hero-grid { gap: 32px; } h1 { font-size: clamp(3.3rem, 6.8vw, 5rem); } .hero-actions { gap: 20px; } }
  @media (max-width: 767px) {
    .hero { padding-top: 25px; }
    .hero-topline .draft-note { font-size: 9px; }
    .hero-topline .eyebrow { font-size: 9px; letter-spacing: .09em; }
    .hero-grid { grid-template-columns: 1fr; padding-block: 48px 30px; gap: 40px; }
    h1 { font-size: clamp(3.4rem, 12.8vw, 5.8rem); }
    .hero-subline { font-size: 16px; margin-top: 24px; }
    .hero-actions { margin-top: 26px; }
    .hero-note { margin-top: 18px; }
    .hero-image :global(img) { aspect-ratio: 1.45; }
  }
</style>
