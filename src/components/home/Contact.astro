---
import type { CollectionEntry } from 'astro:content';
import Icon from '../Icon.astro';
interface Props {
  content: CollectionEntry<'homepage'>['data']['contact'];
  services: CollectionEntry<'homepage'>['data']['services']['items'];
}
const { content, services } = Astro.props;
---
<section class="contact-section" id="calendly" aria-labelledby="contact-heading">
  <div class="shell contact-shell reveal-on-scroll">
    <div class="contact-intro">
      <p class="eyebrow"><span class="section-index">05 /</span>{content.eyebrow}</p>
      <h2 class="section-heading" id="contact-heading">{content.heading}<br /><span class="editorial">{content.emphasis}</span></h2>
      <p class="contact-description">{content.description}</p>
      <a class="button button-dark" href={content.booking.href}>{content.booking.label}<Icon /></a>
      <div class="email-contact"><span>{content.emailLabel}</span><a class="text-link" href={`mailto:${content.email}`}>{content.email}</a></div>
    </div>
    <div class="contact-preview">
      <h3 id="form-heading">{content.formHeading}</h3>
      <p class="form-note" id="form-note">{content.formNote}</p>
      <!-- Phase 2 layout only. Enable fields inside the Phase 4 form component. -->
      <fieldset disabled aria-labelledby="form-heading" aria-describedby="form-note">
        <div class="field-grid">
          <label>{content.name}<input name="name" autocomplete="name" placeholder={content.namePlaceholder} /></label>
          <label>{content.emailField}<input name="email" type="email" autocomplete="email" placeholder={content.emailPlaceholder} /></label>
          <label>{content.company}<span class="optional">{content.optional}</span><input name="companyName" autocomplete="organization" placeholder={content.companyPlaceholder} /></label>
          <label>{content.service}<select name="serviceType"><option value="">{content.servicePlaceholder}</option>{services.map((service) => <option value={service.name}>{service.name}</option>)}</select></label>
          <label class="message-field">{content.message}<textarea name="projectDescription" rows="3" placeholder={content.messagePlaceholder}></textarea></label>
        </div>
        <button class="button button-dark" type="button" disabled>{content.submit}<Icon /></button>
      </fieldset>
    </div>
  </div>
</section>
<style>
  .contact-section { padding: 0 0 80px; }
  .contact-shell { display: grid; grid-template-columns: 1fr 1fr; gap: 70px; background: var(--color-accent-soft); border-radius: 18px; padding: 58px 48px; }
  .contact-intro .eyebrow { font-size: 10px; margin-bottom: 34px; }
  .contact-intro h2 { font-size: clamp(2.5rem, 3.9vw, 3.8rem); }
  .contact-description { max-width: 320px; font-size: 14px; line-height: 1.75; margin-top: 25px; color: var(--color-muted); }
  .contact-intro > .button { margin-top: 30px; }
  .email-contact { margin-top: 32px; display: flex; flex-direction: column; gap: 10px; }
  .email-contact > span { font-size: 11px; color: var(--color-muted); }
  .email-contact .text-link { align-self: flex-start; }
  h3 { font-size: 21px; letter-spacing: -.035em; }
  .form-note { font-size: 11px; line-height: 1.65; margin-top: 10px; color: var(--color-muted); max-width: 340px; }
  fieldset { padding: 0; margin: 26px 0 0; border: 0; min-width: 0; }
  .field-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px 18px; }
  label { display: block; font-size: 11px; min-width: 0; line-height: 1.5; }
  input, select, textarea { display: block; width: 100%; min-width: 0; border: 0; border-bottom: 1px solid #bfc3d2; background: transparent; padding: 13px 0; font-size: 12px; border-radius: 0; color: #666960; opacity: 1; -webkit-text-fill-color: #666960; }
  input::placeholder, textarea::placeholder { color: #777a70; }
  .optional { font-size: 9px; color: var(--color-muted); margin-left: 5px; }
  .message-field { grid-column: 1 / -1; }
  textarea { resize: none; }
  fieldset > .button { margin-top: 24px; width: 100%; background: #e0e2df; color: #65665f; cursor: not-allowed; }
  @media (max-width: 1100px) { .contact-shell { padding: 42px 32px; gap: 36px; } .field-grid { grid-template-columns: 1fr; gap: 18px; } }
  @media (max-width: 767px) { .contact-section { padding-bottom: 48px; } .contact-shell { grid-template-columns: 1fr; padding: 36px 24px; gap: 46px; } .contact-intro h2 { font-size: clamp(2.3rem, 9vw, 3.2rem); } .field-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 420px) { .field-grid { grid-template-columns: 1fr; } }
</style>
