---
import type { CollectionEntry } from 'astro:content';
import Icon from '../Icon.astro';

interface Props {
  content: CollectionEntry<'skills'>['data']['needs']['items'][number];
}
const { content } = Astro.props;
const icon = content.service === 'training' ? 'wrench' : content.service === 'video' ? 'document' : 'user-plus';
---
<article class="learning-need-row reveal-on-scroll">
  <div class="need-heading"><Icon name={icon} /><h3>{content.heading}</h3></div>
  <div class="need-description">
    <p>{content.description}</p>
  </div>
</article>

<style>
  .learning-need-row {
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(32px, 6vw, 96px);
    padding-block: clamp(36px, 4vw, 56px);
    border-top: 1px solid #18181b40;
  }
  .learning-need-row:last-child { border-bottom: 1px solid #18181b40; }
  .need-heading { display: flex; align-items: flex-start; gap: clamp(16px, 2vw, 28px); min-width: 0; }
  .need-heading :global(svg) { width: clamp(34px, 3.4vw, 48px); height: clamp(34px, 3.4vw, 48px); flex: none; margin-top: .15em; color: #18181b; }
  h3 { max-width: 560px; color: #18181b; font-size: clamp(2rem, 3.4vw, 3.5rem); font-weight: 700; line-height: 1.12; letter-spacing: -.045em; text-wrap: balance; }
  .need-description { min-width: 0; }
  p { font-size: clamp(17px, 1.5vw, 21px); line-height: 1.65; color: var(--color-ink); }
  @media (max-width: 767px) {
    .learning-need-row { grid-template-columns: 1fr; gap: 20px; padding-block: 32px; }
    h3 { max-width: none; }
  }
</style>
