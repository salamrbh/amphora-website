---
import type { CollectionEntry } from 'astro:content';
import Icon from '../Icon.astro';

interface Props {
  content: CollectionEntry<'skills'>['data']['needs']['items'][number];
}
const { content } = Astro.props;
---
<article class="learning-need-card reveal-on-scroll">
  <span class="card-number">{content.number}</span>
  <h3>{content.heading}</h3>
  <p>{content.description}</p>
  <a class="text-link" href={`#service-${content.service}`}>{content.link}<Icon /></a>
</article>

<style>
  .learning-need-card {
    --card-accent: var(--color-blue);
    position: relative;
    isolation: isolate;
    min-width: 0;
    border: 1px solid transparent;
    border-radius: 22.4px;
    padding: 25.6px;
    display: flex;
    flex-direction: column;
    align-items: start;
    background: linear-gradient(125deg, #fcfcff, #fffaf8) padding-box, linear-gradient(125deg, color-mix(in srgb, var(--card-accent) 65%, white), #ece7ff 48%, #ffcbb6) border-box;
    box-shadow: 0 16px 36px #28282605;
  }
  .learning-need-card:nth-child(2) { --card-accent: var(--color-red); }
  .learning-need-card:nth-child(3) { --card-accent: var(--color-orange); }
  .learning-need-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    pointer-events: none;
    background: radial-gradient(ellipse at 100% 0%, color-mix(in srgb, var(--card-accent) 16%, transparent), transparent 58%);
  }
  .card-number { align-self: flex-start; display: inline-flex; align-items: center; justify-content: center; min-width: 35.2px; min-height: 24px; padding: 4px 11.2px; border: 1px solid #dedde3; border-radius: 100px; color: #70707c; font-size: 9px; }
  h3 { font-size: 24px; line-height: 1.2; letter-spacing: -.035em; margin-top: 24px; max-width: 260px; }
  p { font-size: 14px; line-height: 1.8; color: var(--color-muted); margin-top: 18px; }
  a { margin-top: auto; padding-top: 24px; min-height: 44px; font-size: 12px; }
  a :global(svg) { width: 16px; height: 16px; }
  @media (hover: hover) and (pointer: fine) {
    .learning-need-card { transition: box-shadow 180ms ease; }
    .learning-need-card:hover { box-shadow: 0 12px 32px color-mix(in srgb, var(--card-accent) 12%, transparent); }
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .learning-need-card {
      translate: 0 0;
      will-change: translate;
      transition: box-shadow 180ms ease, translate 500ms cubic-bezier(.22, 1, .36, 1), opacity 700ms cubic-bezier(.22, 1, .36, 1), transform 700ms cubic-bezier(.22, 1, .36, 1);
    }
    .learning-need-card:hover { translate: 0 -3px; }
  }
  @media (max-width: 767px) {
    .learning-need-card { padding: 22.4px; }
    h3 { max-width: none; margin-top: 15px; }
    p { margin-top: 12px; }
    a { padding-top: 18px; }
  }
</style>
