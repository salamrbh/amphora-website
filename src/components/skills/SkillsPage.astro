---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Icon from '../Icon.astro';
import LocalPicture from '../LocalPicture.astro';
import SectionHeading from '../systems/SectionHeading.astro';
import Contact from './Contact.astro';
import LearningNeedCard from './LearningNeedCard.astro';
import marcel from '../../assets/team/marcel-original.png';
import routes from '../../content/routes.json';
const entry = await getEntry('skills', 'en');
if (!entry) throw new Error('Missing Skills content.');
const c = entry.data;
const servicesHeadingWord = c.services.heading.split(' ')[0];
const enquiry = (service: string) => `${routes.skills}?service=${service}#contact`;
---
<Layout title={c.title} description={c.description}>
  <section class="skills-hero shell" aria-labelledby="skills-heading">
    <div class="topline"><p class="eyebrow"><span class="section-index">01 /</span>{c.hero.eyebrow}</p><p class="draft-note">{c.draftLabel}</p></div>
    <div class="hero-grid">
      <div class="hero-copy">
        <h1 id="skills-heading">{c.hero.heading}<br /><span class="editorial">{c.hero.emphasis}</span></h1>
        <p class="hero-description">{c.hero.subline}</p>
        <div class="hero-actions"><a class="button button-dark button-metallic" href={`${routes.booking}?area=skills`}>{c.hero.primary}<Icon /></a><a class="text-link" href="#sample">{c.hero.secondary}</a></div>
        <p class="hero-note">{c.hero.note}</p>
      </div>
      <div class="hero-visual">
        <figure class="hero-photo"><LocalPicture src="/images/team/consultation-1280.webp" alt={c.hero.imageAlt} width={1280} height={853} eager responsive sizes="(min-width: 768px) 44vw, calc(100vw - 40px)" /><figcaption>{c.hero.imageCaption}</figcaption></figure>
        <div class="learning-card"><div class="learning-symbol" aria-hidden="true"><span></span><span></span><span></span></div><p class="eyebrow">{c.hero.cardLabel}</p><p class="learning-title">{c.hero.cardHeading}</p><p class="learning-note">{c.hero.cardNote}</p></div>
      </div>
    </div>
    <nav class="page-nav" aria-label="Skills sections">{c.navigation.map(item => <a href={item.href}><span class="page-nav-label">{item.label}</span><span aria-hidden="true">↘</span></a>)}</nav>
  </section>

  <section class="trust shell" aria-labelledby="trust-heading" data-content-slot="trust">
    <div><p class="eyebrow"><span class="section-index">02 /</span>{c.trust.eyebrow}</p><h2 id="trust-heading">{c.trust.heading}</h2></div>
    <div class="trust-space"><span class="quote-mark editorial" aria-hidden="true">“</span><div><p>{c.trust.placeholder}</p><p class="small-note">{c.trust.note}</p></div></div>
  </section>

  <section class="section shell" id="needs" aria-labelledby="needs-heading">
    <SectionHeading number="03" id="needs-heading" content={c.needs} />
    <div class="needs-grid">{c.needs.items.map(item => <LearningNeedCard content={item} />)}</div>
  </section>

  <section class="section sample-section" id="sample" aria-labelledby="sample-heading" data-content-slot="course-sample"><div class="shell">
    <SectionHeading number="04" id="sample-heading" content={c.sample} />
    <div class="sample-grid"><div class="sample-space"><span class="tag">{c.sample.status}</span><div class="sample-art" aria-hidden="true"><span></span><span></span><span></span></div><div><h3>{c.sample.placeholder}</h3><p>{c.sample.note}</p></div></div><ol class="sample-steps">{c.sample.steps.map((step, i) => <li><span class="step-index">0{i + 1}</span><div><h3>{step.name}</h3><p>{step.description}</p></div></li>)}</ol></div>
  </div></section>

  <section class="section shell" id="services" aria-labelledby="services-heading">
    <SectionHeading number="05" id="services-heading" content={c.services}>
      <Fragment slot="heading"><span class="services-heading-metallic">{servicesHeadingWord}</span>{c.services.heading.slice(servicesHeadingWord.length)}</Fragment>
    </SectionHeading>
    <div class="services-grid">
      {c.services.items.map(item => <article class:list={['service-card', item.accent, 'reveal-on-scroll']} id={`service-${item.id}`}>
        <span class="service-gradient" aria-hidden="true"></span>
        <span class="service-number">{item.number}</span>
        <h3>{item.name}</h3>
        <p class="service-description">{item.useCase}</p>
        <dl class="service-details">{[item.service, item.outcome].map((text, i) => <div><dt>{c.services.labels[i + 1]}</dt><dd>{text}</dd></div>)}</dl>
        <a class="text-link" href={enquiry(item.id)} data-enquiry-service={item.id}>{c.services.cta}<Icon /></a>
      </article>)}
    </div>
  </section>

  <section class="section projects-section" id="projects" aria-labelledby="projects-heading"><div class="shell">
    <SectionHeading number="06" id="projects-heading" content={c.projects}>
      <Fragment slot="emphasis">{c.projects.emphasis.split(/(\buseful\b)/).map(part => part === 'useful' ? <span class="projects-heading-metallic">{part}</span> : part)}</Fragment>
    </SectionHeading>
    <div class="project-grid">{c.projects.items.map(item => <article class="project-card"><div class="project-title"><span class="editorial">{item.number}</span><p class="small-note">{c.projects.status}</p></div><h3>{item.heading}</h3><dl>{[item.situation, item.service, item.outcome].map((text, i) => <div><dt>{c.projects.labels[i]}</dt><dd>{text}</dd></div>)}</dl></article>)}</div>
  </div></section>

  <section class="section shell" id="process" aria-labelledby="process-heading">
    <SectionHeading number="07" id="process-heading" content={c.process}>
      <Fragment slot="emphasis">{c.process.emphasis.split(/(\btogether\b\.?)/).map(part => /^together\.?$/.test(part) ? <span class="process-heading-outline" data-text={part}>{part}</span> : part)}</Fragment>
    </SectionHeading>
    <div class="process-grid">{c.process.items.map(item => <article class="process-card reveal-on-scroll"><span class="service-number">{item.number}</span><h3>{item.name}</h3><p>{item.description}</p><div class="your-part"><span>{c.process.effortLabel}</span><p>{item.effort}</p></div></article>)}</div>
  </section>

  <section class="partners-section shell" id="partners" aria-labelledby="partners-heading" data-content-slot="education-partners">
    <div class="partners-copy"><p class="eyebrow"><span class="section-index">08 /</span>{c.partners.eyebrow}</p><h2 class="section-heading" id="partners-heading">{c.partners.heading}<br /><span class="editorial">{c.partners.emphasis}</span></h2><p class="body-copy">{c.partners.description}</p><div class="partner-tags">{c.partners.tags.map(tag => <span class="tag">{tag}</span>)}</div><a class="button button-dark button-metallic" href={enquiry('partnership')} data-enquiry-service="partnership">{c.partners.cta}<Icon /></a></div>
    <div class="partner-space"><span class="partner-mark" aria-hidden="true">+</span><h3>{c.partners.placeholder}</h3><p>{c.partners.note}</p></div>
  </section>

  <div class="faq-stack">
  <section class="section shell about-section" id="about" aria-labelledby="about-heading">
    <div><p class="eyebrow"><span class="section-index">09 /</span>{c.about.eyebrow}</p><h2 class="section-heading" id="about-heading">{c.about.heading}<br /><span class="editorial">{c.about.emphasis}</span></h2><p class="body-copy">{c.about.description}</p><p class="body-copy connection">{c.about.connection}</p><a class="text-link" href="#contact">{c.about.cta}<Icon /></a></div>
    <div class="people"><figure class="marcel"><div class="portrait-frame"><div class="portrait"><Image src={marcel} alt={c.about.imageAlt} width={480} height={540} widths={[240,360,480]} sizes="(min-width: 768px) 340px, 85vw" format="webp" quality={82} loading="lazy" /></div></div><figcaption><h3>{c.about.name}</h3><p>{c.about.role}</p><p class="small-note">{c.about.bioNote}</p></figcaption></figure><a class="systems-person" href={`${routes.systems}#about`}><span class="portrait-frame portrait-frame-avatar"><LocalPicture src="/images/team/salam-192.webp" alt="" width={192} height={192} /></span><span><strong>{c.about.secondaryName}</strong><span>{c.about.secondaryRole}</span></span><Icon /></a></div>
  </section>

  <section class="section faq-section" id="faq" aria-labelledby="faq-heading"><div class="shell faq-panel">
    <SectionHeading number="10" id="faq-heading" content={c.faq}>
      <span slot="heading" class="faq-heading-first">{c.faq.heading}</span>
    </SectionHeading>
    <div class="faq-list">{c.faq.items.map(item => <details><summary>{item.question}<Icon name="plus" /></summary><p>{item.answer}</p></details>)}</div>
  </div></section>
  </div>
  <Contact content={c.contact} services={c.services.items} crossLink={c.crossLink} />
</Layout>
<script>
  const about = document.querySelector<HTMLElement>('.faq-stack .about-section');
  if (about && 'ResizeObserver' in window) {
    const observer = new ResizeObserver(() => {
      about.style.setProperty('--about-height', `${about.offsetHeight}px`);
      about.classList.add('scroll-backdrop');
    });
    observer.observe(about);
  }
</script>
<style>
  .skills-hero { padding-top: 38px; }
  .topline { display: flex; justify-content: space-between; align-items: center; gap: 20px; }
  .topline .section-index { flex: none; white-space: nowrap; }
  .hero-grid { display: grid; grid-template-columns: 1.2fr 1fr; align-items: center; gap: 52px; padding-block: 64px 60px; }
  h1 { font-size: clamp(3.4rem, 6.3vw, 6rem); line-height: 1.04; letter-spacing: -.065em; }
  h1 .editorial {
    display: inline-block;
    padding-inline: .06em;
    margin-inline: -.06em;
    background-image: linear-gradient(165deg, transparent 20%, #ffffff14 37%, #ffffff70 46%, #ffffff12 50%, #17172c24 55%, transparent 68%), var(--brand-gradient-interactive);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  @media (forced-colors: active) { h1 .editorial { background: none; color: inherit; opacity: 1; } }
  .hero-description { max-width: 440px; margin-top: 28px; font-size: 17px; line-height: 1.75; color: var(--color-muted); }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 22px; margin-top: 30px; }
  .hero-actions .text-link { font-size: 12px; min-height: 44px; }
  .hero-note { font-size: 11px; color: var(--color-muted); margin-top: 26px; }
  .hero-visual { padding: 0 0 30px 14px; position: relative; }
  figure { margin: 0; }
  .hero-photo { position: relative; border-radius: 18px; overflow: hidden; background: var(--color-surface); }
  .hero-photo :global(img) { width: 100%; height: auto; aspect-ratio: 1.04; object-fit: cover; object-position: 57% center; }
  .hero-photo figcaption { position: absolute; top: 18px; left: 18px; right: 18px; width: fit-content; padding: 10px 14px; border-radius: 6px; background: #fffffff2; font-size: 11px; line-height: 1.5; }
  .learning-card { position: relative; width: 88%; margin: -45px 0 0 -20px; padding: 25px; border: 1px solid #e1e4f3; border-radius: 12px; background: #f4f5ff; box-shadow: 0 12px 30px #2828260a; }
  .learning-card .eyebrow { font-size: 9px; color: #525878; }
  .learning-title { font-size: 21px; letter-spacing: -.035em; margin-top: 13px; }
  .learning-note { font-size: 11px; color: var(--color-muted); line-height: 1.6; margin-top: 8px; max-width: 250px; }
  .learning-symbol { float: right; display: flex; align-items: end; gap: 5px; margin-left: 12px; height: 36px; }
  .learning-symbol span { width: 9px; height: 18px; border-radius: 3px; background: var(--color-blue); }
  .learning-symbol span:nth-child(2) { height: 27px; background: var(--color-purple); }
  .learning-symbol span:nth-child(3) { height: 36px; background: var(--color-red); }
  .page-nav {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }
  .page-nav a {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-width: 0;
    overflow: hidden;
    padding: 21px 24px;
    border: 1px solid transparent;
    border-radius: 16px;
    background:
      radial-gradient(circle at 7% 0%, #39c9cb18 0%, transparent 38%) padding-box,
      radial-gradient(circle at 93% 100%, #ec6f8b12 0%, transparent 40%) padding-box,
      linear-gradient(110deg, #ffffff9e 0%, #f8f7fa61 52%, #ffffff82 100%) padding-box;
    box-shadow:
      inset 0 1px 1px #fff,
      inset 0 -1px 2px #28282612,
      0 10px 24px #2828260f,
      0 0 0 1px #28282608;
    -webkit-backdrop-filter: blur(18px) saturate(1.25);
    backdrop-filter: blur(18px) saturate(1.25);
    color: var(--color-ink);
    font-size: 12px;
    text-shadow: 0 1px 0 #fff;
    transition: background-color 220ms ease, box-shadow 220ms ease, color 220ms ease;
  }
  .page-nav a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    padding: 1px;
    border-radius: inherit;
    background: var(--brand-gradient);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask-composite: exclude;
    opacity: .2;
    pointer-events: none;
  }
  .page-nav a:hover, .page-nav a:focus-visible {
    background-color: #ffffff80;
    box-shadow: inset 0 1px 1px #fff, inset 0 -1px 2px #28282612, 0 12px 26px #28282617, 0 0 0 1px #28282608;
    color: var(--color-ink);
  }
  .page-nav-label { display: inline-block; }
  .page-nav a:is(:hover, :focus-visible) .page-nav-label {
    background-image: var(--brand-gradient);
    background-size: 100% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    text-shadow: none;
  }
  @media (forced-colors: active) {
    .page-nav a:is(:hover, :focus-visible) .page-nav-label { background: none; color: LinkText; }
  }
  .trust { display: grid; grid-template-columns: 1fr 1.2fr; gap: 40px; align-items: center; padding-block: 44px; border-bottom: 1px solid var(--color-line); }
  .trust h2 { margin-top: 15px; font-size: 19px; letter-spacing: -.025em; }
  .trust-space { min-height: 110px; display: flex; align-items: center; gap: 24px; border: 1px dashed #cbcbc4; border-radius: 12px; padding: 20px 28px; }
  .quote-mark { font-size: 64px; line-height: 1; color: #9299be; }
  .trust-space p { font-size: 14px; }
  .small-note { font-size: 11px !important; line-height: 1.65; color: var(--color-muted); }
  .trust-space .small-note { margin-top: 6px; }
  .needs-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 19.2px; }
  .process-card {
    --card-accent: var(--color-blue);
    position: relative;
    isolation: isolate;
    min-width: 0;
    border: 1px solid transparent;
    border-radius: 22.4px;
    padding: 25.6px;
    display: flex;
    flex-direction: column;
    align-items: start;
    background: var(--process-card-fill, linear-gradient(125deg, #fcfcff, #fffaf8)) padding-box, linear-gradient(125deg, color-mix(in srgb, var(--card-accent) 65%, white), #ece7ff 48%, #ffcbb6) border-box;
    box-shadow: 0 16px 36px #28282605;
  }
  .process-card:nth-child(2) { --card-accent: var(--color-red); }
  .process-card:nth-child(3) { --card-accent: var(--color-orange); }
  .process-card:nth-child(4) { --card-accent: var(--color-purple); }
  .process-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    pointer-events: none;
    background: radial-gradient(ellipse at 100% 0%, color-mix(in srgb, var(--card-accent) 16%, transparent), transparent 58%);
  }
  h3 { font-size: 24px; line-height: 1.2; letter-spacing: -.035em; }
  .process-card > p { font-size: 14px; line-height: 1.8; color: var(--color-muted); margin-top: 18px; }
  .text-link :global(svg) { width: 16px; height: 16px; }
  .sample-section { background: var(--color-surface); }
  .sample-grid { display: grid; grid-template-columns: 1.5fr 1fr; gap: 64px; align-items: center; }
  .sample-space { min-height: 400px; background: #eef0fa; border: 1px dashed #bfc6e2; border-radius: 16px; padding: 28px 32px; display: flex; flex-direction: column; justify-content: space-between; align-items: start; }
  .sample-space .tag { border-color: #c7cbe0; color: #525878; }
  .sample-space p { max-width: 410px; color: #62677b; font-size: 13px; line-height: 1.8; margin-top: 12px; }
  .sample-art { display: flex; align-items: center; justify-content: center; width: 100%; height: 160px; }
  .sample-art span { display: block; width: 80px; height: 105px; border: 1px solid #8e9be5; border-radius: 13px; transform: rotate(-14deg); background: #ffffff66; }
  .sample-art span:nth-child(2) { transform: rotate(0); margin-left: -25px; background: #dce1ff; }
  .sample-art span:nth-child(3) { transform: rotate(14deg); margin-left: -25px; background: #eff0ff; }
  .sample-steps { list-style: none; padding: 0; margin: 0; }
  .sample-steps li { display: flex; gap: 24px; padding: 23px 0; border-bottom: 1px solid #ddddd5; }
  .sample-steps li:first-child { padding-top: 0; }
  .step-index { font-size: 11px; color: #4651bd; padding-top: 4px; }
  .sample-steps h3 { font-size: 20px; }
  .sample-steps p { color: var(--color-muted); font-size: 13px; line-height: 1.8; margin-top: 8px; }
  .services-heading-metallic, .projects-heading-metallic {
    display: inline-block;
    background-image: linear-gradient(165deg, transparent 20%, #ffffff14 37%, #ffffff70 46%, #ffffff12 50%, #17172c24 55%, transparent 68%), var(--brand-gradient-interactive);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .projects-heading-metallic { padding: 0 .06em .2em; margin: 0 -.06em -.2em; }
  @media (forced-colors: active) { .services-heading-metallic, .projects-heading-metallic { background: none; color: inherit; } }
  .services-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 19.2px; }
  .service-card {
    --card-accent: var(--color-blue);
    position: relative;
    isolation: isolate;
    min-width: 0;
    border: 1px solid transparent;
    border-radius: 22.4px;
    padding: 25.6px;
    display: flex;
    flex-direction: column;
    background: linear-gradient(125deg, #fcfcff, #fffaf8) padding-box, linear-gradient(125deg, color-mix(in srgb, var(--card-accent) 65%, white), #ece7ff 48%, #ffcbb6) border-box;
    box-shadow: 0 16px 36px #28282605;
  }
  .service-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    pointer-events: none;
    background: radial-gradient(ellipse at 100% 0%, color-mix(in srgb, var(--card-accent) 16%, transparent), transparent 58%), repeating-linear-gradient(125deg, #ffffff50 0, #ffffff00 24px, #ffffff50 52px);
  }
  .service-gradient {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    pointer-events: none;
    background: var(--brand-gradient-interactive);
    opacity: 0;
    transition: opacity 240ms ease;
  }
  .service-card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    pointer-events: none;
    background: linear-gradient(180deg, transparent 35%, #aeb4c414 42%, #ffffffcc 48%, #ffffffee 50%, #aeb4c426 54%, transparent 63%);
    background-size: 100% 300%;
    background-position: 0 100%;
    opacity: 0;
  }
  @keyframes service-metallic-slide {
    0% { background-position: 0 100%; opacity: 0; }
    15%, 80% { opacity: 1; }
    100% { background-position: 0 0; opacity: 0; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .service-card::after { animation: service-metallic-slide 7s linear infinite; }
  }
  .red { --card-accent: var(--color-red); } .orange { --card-accent: var(--color-orange); } .purple { --card-accent: var(--color-purple); }
  .service-number { align-self: flex-start; display: inline-flex; align-items: center; justify-content: center; min-width: 35.2px; min-height: 24px; padding: 4px 11.2px; border: 1px solid #dedde3; border-radius: 100px; color: #70707c; font-size: 9px; }
  .service-card h3 { font-size: clamp(25.6px, 2.8vw, 40px); line-height: 1.08; min-height: 2.16em; letter-spacing: -.055em; font-weight: 700; margin-top: 22.4px; color: #18181b; }
  .service-description { margin-top: 17.6px; min-height: 4.95em; font-size: 12.8px; line-height: 1.65; color: #686872; max-width: 54ch; }
  dl { margin: 22px 0 0; }
  dl > div { padding-block: 15px; border-top: 1px solid var(--color-line); }
  dt { text-transform: uppercase; font-size: 9px; font-weight: 500; letter-spacing: .08em; }
  dd { margin: 8px 0 0; font-size: 12px; color: var(--color-muted); line-height: 1.8; }
  .service-details { display: grid; grid-template-columns: 1fr; grid-template-rows: repeat(2, 1fr); flex: 1; gap: 19.2px; margin: 22.4px 0 16px; border-top: 1px solid #dedde3; }
  .service-details > div { border: 0; padding: 16px 0 0; }
  .service-details dt { color: #55555e; }
  .service-details dd { margin-top: 6.4px; font-size: 11px; color: #686872; }
  .service-card a { margin-top: auto; padding-block: 9.6px 3.2px; padding-right: 16px; min-height: 44px; font-size: 11px; justify-content: space-between; }
  .service-card a :global(svg) { width: 15.2px; height: 15.2px; }
  .service-card:target { outline: 2px solid var(--card-accent); outline-offset: 4px; }
  .service-card:is(:hover, :focus-within) .service-gradient { opacity: 1; }
  .service-card:is(:hover, :focus-within) :is(h3, .service-description, .service-number, dt, dd, a) { color: white; }
  .service-card:is(:hover, :focus-within) :is(.service-number, .service-details) { border-color: #ffffff80; }
  .service-card:is(:hover, :focus-within) a { text-decoration-color: #ffffff99; }
  .service-card:is(:hover, :focus-within)::after { background-image: linear-gradient(180deg, transparent 35%, #ffffff0a 42%, #ffffff26 48%, #ffffff38 50%, #ffffff0d 54%, transparent 63%); }
  .service-card a:focus-visible { outline-color: white; }
  .projects-section { border-block: 1px solid var(--color-line); }
  .project-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 28px; }
  .project-card {
    position: relative;
    isolation: isolate;
    padding: 32px;
    border: 1px solid transparent;
    border-radius: 14px;
